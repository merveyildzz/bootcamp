# --- Database (SQLite) ---
# Tek bir dosya, kurulum gerektirmez. Boş bırakılırsa varsayılan (data/style_mind.db)
# kullanılır — genelde bu satırı hiç değiştirmenize gerek yok.
DATABASE_PATH=data/style_mind.db

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=8388608
STAGING_MAX_AGE_HOURS=24

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- AI ---
# OPSİYONEL: aistudio.google.com üzerinden alınan Gemini API key.
# Boş bırakılırsa uygulama normal çalışmaya devam eder — sadece kıyafet fotoğrafı
# yüklerken otomatik kategori/renk/stil tespiti yapılmaz, form boş açılır ve
# alanları elle doldurursunuz. Anahtarı sonradan da ekleyebilirsiniz.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
